                <input type="text" name="Email" class="form-control form-control-lg" id="exampleInputEmail1" placeholder="Username">
              </div>
              <div class="form-group">
                <input type="password" name="Password" class="form-control form-control-lg" id="exampleInputPassword1"
                  placeholder="Password">
              </div>
              <div class="mt-3">
                <button class="btn btn-block btn-gradient-primary btn-lg font-weight-medium auth-form-btn"
                  type="submit">SIGN IN</button>
              </div>
              <div class="my-2 d-flex justify-content-between align-items-center">
                <div class="form-check">
                  <label class="form-check-label text-muted">
                    <input type="checkbox" class="form-check-input"> Keep me signed in </label>
                </div>
                <a href="#" class="auth-link text-black">Forgot password?</a>
              </div>
              <div class="mb-2">
                <button type="button" class="btn btn-block btn-facebook auth-form-btn">
                  <i class="mdi mdi-facebook me-2"></i>Connect using facebook </button>
              </div>
              <div class="text-center mt-4 font-weight-light"> Don't have an account? <a href="register.html"
                  class="text-primary">Create</a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
