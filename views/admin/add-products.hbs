<div class="main-panel">
    <div class="content-wrapper">

        <div class="row">
            <div class="col-md-6 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Product Details</h4>
                        <p class="card-description"> This will show to the coustmers </p>
                        <form class="forms-sample" id="addProduct">
                            <div class="form-group row">
                                <label for="exampleInputUsername2" class="col-sm-3 col-form-label">Product ID</label>
                                <div class="col-sm-9">
                                    <input type="text" class="form-control" id="exampleInputUsername2"
                                        placeholder="example &quot;#1&quot" name="name" required>
                                </div>
                            </div>


                            <div class="form-group row">
                                <label for="exampleSelectGender col-sm-3 col-form-label">Price</label>
                                <div class="input-group col-sm-9">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-gradient-primary text-white">₹</span>
                                    </div>
                                    <input type="number" class="form-control" id="Amount"
                                        aria-label="Amount (to the nearest dollar)" name="price" required>
                                </div>
                            </div>


                            <div class="form-group">
                                <label for="exampleSelectGender">Category</label>
                                <select class=" btn btn-block btn-outline-primary dropdown-toggle"
                                    id="exampleSelectGender" style="width: 100%;" name="category" required>
                                    <option hidden selected>Select Catagory</option>
                                    {{#each categories}}
                                    <option name="category" value="{{this.category}}">{{this.category}}</option>
                                    {{/each}}
                                </select>
                            </div>

                            <div class="form-group row">
                                <label for="exampleTextarea1">Description</label>
                                <textarea class="form-control" id="exampleTextarea1" rows="4" name="description"
                                    required></textarea>
                            </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Upload Product Images</h4>
                        <p class="card-description"> You product images </p>

                        <div class="form-group">
                            <label>File upload</label>
                            <input type="file" id="images" class="btn btn-gradient-primary me-2" name="image" required multiple>
                        </div>
                    </div>
                </div>
            </div>


        </div>
        <div class="d-flex align-items-center">
            <input type="submit" class="btn btn-gradient-primary me-3 "></input>
            {{!-- <button type="submit" class="btn btn-gradient-primary me-3 ">Submit</button> --}}
            <h4 class="">Add product and submit...</h4>
            </form>
        </div>



    </div>
</div>

<script>

    $('form#addProduct').submit(function(e) {
        e.preventDefault();

        var formData = new FormData(this);

        $.ajax({
            url: '/admin/add-item',
            type: 'POST',
            data: formData,
            success: function (data) {
                swal("Success!", data,).then(() => {
                    $('#exampleInputUsername2').val('');
                    $('#Amount').val('');
                    $('#exampleTextarea1').val('');
                    $('#images').val('');
                })
            },
            cache: false,
            contentType: false,
            processData: false
        });
    })

</script>

{{!-- action="/admin/add-item" method="POST" enctype="multipart/form-data" --}}