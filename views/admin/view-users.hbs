<div class="main-panel">
    <div class="content-wrapper">

        <div class="col-lg-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">KarmaCommerce Users</h4>
                    <p class="card-description"> Status of your users<code>avilables</code>
                    </p>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each users}}
                            <tr>
                                <td class="py-1">
                                    <img src="../../assets/images/faces-clipart/pic-{{inc @index}}.png" alt="image" />
                                </td>
                                <td>{{this.username}} </td>
                                <td> {{this.Email}}</td>
                                <td> {{this.Phone}} </td>
                                {{#if this.block}}
                                <td>
                                    <p style="color: red;">Blocked</p>
                                </td>
                                <td><button id="unblockUser" onclick=" unblockUser('{{this._id}}', '{{this.username}}')"
                                        class="btn btn-danger btn-md">UnBlock</button></td>
                                {{else}}
                                <td>
                                    <p style="color: rgb(23, 209, 23);">Active</p>
                                </td>
                                <td>
                                    <button onclick="blockUser('{{this._id}}', '{{this.username}}')"
                                        class="btn btn-primary btn-md">Block</button>
                                </td>
                                {{/if}}
                            </tr>

                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>