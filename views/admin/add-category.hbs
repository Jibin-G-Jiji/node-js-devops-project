<div class="main-panel">
    <div class="content-wrapper">
        <div class="row">
            <div class="col-md-6 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Add Category</h4>
                        <form class="forms-sample" id="submitCopon" >
                            <div class="form-group">
                                <label for="exampleInputUsername1">Category Name</label>
                                <input type="text" class="form-control" id="exampleInputUsername1"
                                    placeholder="Categoryname" name="category">
                            </div>
                            <button onclick="submitCategory" type="submit" class="btn btn-gradient-primary me-2">Submit</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $('#submitCopon').submit((e) => {
        e.preventDefault();
        $.ajax({
            url: '/admin/add-category',
            method: 'post',
            data: $('#submitCopon').serialize(),
            success: (res) => {
                console.log(res);
                swal("Success!", res , "success").then(() => {
                    $('#exampleInputUsername1').val('');
                })
            }
        })
    })

</script>
