<script>
  function cancelOrder(orderId, status, paymentMethod, total, order) {
    swal({
      text: 'Are you sure to ' + status + ' this order',
      // buttons: true,
      // dangerMode: true
    }).then((willCancel) => {
      if (willCancel) {
        $.ajax({
          url: "/user-cancel-order",
          data: {
            order: orderId,
            status: status,
            paymentMethod: paymentMethod,
            total: total,
            orderId: order
          },
          method: "post",
          success: (response) => {
            if (response.acknowledged) {
              location.reload();
            }
          },
        })
      }

    })
  }

  function returnOrder(orderId, status) {
    swal({
      text: 'Are you sure to ' + status + ' this order',
      // buttons: true,
      // dangerMode: true
    }).then((willCancel) => {
      if (willCancel) {
        $.ajax({
          url: "/return-order",
          data: {
            order: orderId,
            status: status
          },
          method: "post",
          success: (response) => {
            if (response.acknowledged) {
              location.reload();
            }
          },
        })
      }

    })
  }
</script>