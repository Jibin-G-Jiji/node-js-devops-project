                                  data-bs-toggle="dropdown" aria-expanded="false">
                                  view Details
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
                                  <li><a class="dropdown-item btn-sm" href="/view-order-details/{{this._id}}">Order
                                      Details</a></li>
                                  {{#if this.cancel}}
                                  {{else}}
                                  <li><button class="dropdown-item btn-sm"
                                      onclick="returnOrder('{{this._id}}','Return')">Return Order</button></li>
                                  {{#if this.delivered}}
                                  {{else}}
                                  {{#if this.return}}
                                  {{else}}
                                  <li><button class="dropdown-item btn-sm"
                                      onclick="cancelOrder('{{this._id}}','cancelled','{{this.paymentMethod}}','{{this.totalAmount}}', '{{this._id}}')"
                                      style="color:red ;">Cancel Order</button></li>
                                  {{/if}}
                                  {{/if}}

                                  {{/if}}
                                </ul> --}}

                                {{!-- <li class="nav-item submenu ">
                                  <button href="#" class="dropdown-toggle primary-btn" data-toggle="dropdown"
                                    role="button" aria-haspopup="true" aria-expanded="false"
                                    style=" padding: 0 10px; border-radius: 0px;"></button>
                                  <ul class="dropdown-menu">
